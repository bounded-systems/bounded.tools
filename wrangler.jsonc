{
  // bounded.tools — GitHub App receiver + fleet CI snapshot.
  // Deploy: `npx wrangler deploy`. Validate without deploying: `bun run check:worker`.
  //
  // Secret (set with `wrangler secret put`, NEVER here and never in git):
  //   GITHUB_WEBHOOK_SECRET — verifies inbound App deliveries. Absent ⇒ every
  //                           delivery is rejected (the receiver fails closed).
  "name": "bounded-tools",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-21",
  // Same account as every other org Worker (infra/cloudflare/*/wrangler.jsonc).
  // Pinned here rather than left to the deploy environment because the minted
  // token is account-scoped: config that names the account explicitly is how a
  // deploy aimed at the wrong one fails loudly instead of succeeding somewhere
  // unexpected.
  "account_id": "a2ca40f474fa65ed8f751a3efdf74c01",
  "workers_dev": false,
  // hooks.bounded.tools — THE Worker's only hostname, and the fix for deploy run
  // 31886044499, which minted, deployed, and then failed its own probe with
  // "deploy exposed no parseable hostname — nothing was verified": workers_dev
  // is off (deliberately) and no route existed, so the script was live in the
  // account and served nothing. Exactly the blindness the probe exists to catch.
  //
  // A custom DOMAIN, not apex zone routes (bounded.tools/api/*), on the sibling
  // precedent: boot and status attach custom domains with the same scripts-only
  // minted token (the domains API is account-level), whereas zone routes need a
  // zone permission that mint does not carry and would fail the deploy the #131
  // way. The custom domain is part of the deploy on purpose — the hostname
  // binding is version-controlled and moves through the same approval-gated
  // lane as the code (the broker/status/boot rationale, copied).
  //
  // CONSEQUENCE, tracked: the prx App's hook_attributes.url points at the apex
  // path (bounded.tools/api/github/webhooks), which the static site 404s. The
  // hook URL moves to https://hooks.bounded.tools/api/github/webhooks via the
  // broker's /apphook tier — the registry carries the URL, the tier PATCHes it
  // alongside the secret, no hand edit of App settings.
  "routes": [
    {
      "pattern": "hooks.bounded.tools",
      "custom_domain": true
    },
    {
      // github.bounded.tools — the read-only GitHub API door (#36, served at
      // /gh/*). A second custom domain on the SAME Worker, same precedent as
      // hooks above: domains attach with the scripts-only minted token and the
      // binding moves through the approval-gated deploy lane. The door's mint
      // (binding.internal/apptoken/bs-door-github-read) rides the existing
      // BROKER service binding below; the read-scope grant is the broker
      // registry entry in infra, and until that entry exists the door answers
      // 502 at mint — fail-closed, the intended arrival state.
      //
      // Secret (set with `wrangler secret put`, NEVER here and never in git):
      //   DOOR_LEASES — named bearer leases, `name:token` per line. Absent ⇒
      //                 the door refuses every request (503).
      "pattern": "github.bounded.tools",
      "custom_domain": true
    }
  ],
  // A receiver holding a webhook secret should not also be reachable at
  // long-lived preview URLs (same reasoning as cf-oidc-token-broker).
  "preview_urls": false,
  "vars": {
    // Manual OVERRIDE of the coverage denominator, comma-separated. Normally
    // EMPTY: the reconcile cron below keeps the real list (the App's live
    // installation list) in the DO. Setting this forces a specific denominator
    // for debugging; a wrong list claims completeness it does not have.
    "CI_REPOS_KNOWN": "",
    // PR-feed reprojection (.github-private#719). BOTH EMPTY = the pull_request
    // branch adapts and counts but dispatches nothing, which is the correct
    // state until a broker tier exists that mints `contents: write` on the
    // target and nothing else. bs-door-hooks cannot: it is metadata:read only.
    // Set together - either alone leaves the branch disabled.
    "PR_DISPATCH_REPO": "",
    "PR_DISPATCH_APP": ""
  },
  // The reconcile cron (#481 increment 4): hourly, refresh the coverage
  // denominator via the broker's service-binding plane. Off-minute on purpose —
  // the same schedule-spreading habit as the org's other hourly lanes.
  "triggers": {
    "crons": ["43 * * * *"]
  },
  // The mint path for that cron: bounded-tools → cf-token-broker over a service
  // binding (binding.internal/apptoken/bs-door-hooks, downscoped to
  // metadata:read in the broker's APP_BINDING_CONFIG). A binding, not a public
  // call: the broker's binding plane is host-gated to traffic that can only
  // originate from same-account Workers, and THIS declaration — landing through
  // the approval-gated deploy lane — is the grant.
  "services": [
    {
      "binding": "BROKER",
      "service": "cf-token-broker"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        // One instance, named "fleet". Sharding per repo would reintroduce the
        // cross-repo race the DO is here to remove — see src/ci-do.ts.
        "name": "CI_STATE",
        "class_name": "CiStateDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CiStateDO"]
    }
  ]
}
